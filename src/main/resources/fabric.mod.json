{
  "schemaVersion": 1,
  "id": "createcustomportalapiintegration",
  "version": "${version}",
  "name": "Create Custom Portal API Integration 1.20.1 Port",
  "description": "A compatibility mod between Create's trains and customportalapi's portals. Now for 1.20.1!",
  "authors": [
    "ReignOfFROZE",
    "Damienne"
  ],
  "contact": {
    "sources": "https://github.com/MrrrpMreow/create-custom-portal-api-integration"
  },
  "license": "CC0",
  "icon": "assets/createcustomportalapiintegration/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "reign.createaddons.customportalapiintegrations.CreateCustomPortalAPIIntegrationMod"
    ]
  },
  "mixins": [
    "createcustomportalapiintegration.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "create": "${create_version}",
    "minecraft": "${minecraft_version}"
  }
}
